{
  "openapi": "3.0.0",
  "info": {
    "title": "Moji",
    "version": "1.0.0",
    "description": ""
  },
  "servers": [
    {
      "url": "http://localhost:5001/api"
    }
  ],
  "paths": {
    "/users": {
      "get": {
        "tags": [
          "Users"
        ],
        "summary": "Danh sách người dùng có phân trang",
        "description": "Yêu cầu đăng nhập. Loại tài khoản hiện tại; chỉ trả thông tin công khai, sắp xếp _id giảm dần.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "query", "name": "search",
            "description": "Tìm một phần tên hoặc username, không phân biệt hoa thường, trước phân trang.",
            "schema": { "type": "string", "maxLength": 100 }
          },
          {
            "in": "query",
            "name": "page",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            }
          },
          {
            "in": "query",
            "name": "limit",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Trang người dùng, có thể rỗng",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "users",
                    "pagination"
                  ],
                  "properties": {
                    "users": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/DirectoryUser"
                      }
                    },
                    "pagination": {
                      "$ref": "#/components/schemas/UsersPagination"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Tham số phân trang không hợp lệ"
          },
          "401": {
            "description": "Chưa đăng nhập"
          },
          "403": {
            "description": "Token không hợp lệ hoặc đã hết hạn"
          },
          "500": {
            "description": "Lỗi hệ thống"
          }
        }
      }
    },
    "/auth/signup": {
      "post": {
        "summary": "SignUp",
        "tags": ["Authentication"],
        "responses": {},
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "username": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string",
                    "format": "color"
                  },
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "firstName": {
                    "type": "string"
                  },
                  "lastName": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/auth/signin": {
      "post": {
        "summary": "SignIn",
        "description": "Log in với username và password. Browser dùng refresh cookie HttpOnly. Gửi client=mobile để nhận refreshToken trong JSON thay cho cookie.",
        "tags": ["Authentication"],
        "responses": {
          "200": {
            "description": "User successfully signed in",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                  "client": { "type": "string", "enum": ["mobile"], "description": "Chỉ truyền cho native app" },
                    "message": {
                      "type": "string",
                      "example": "User Hai User đã logged in!"
                    },
                    "accessToken": {
                      "type": "string",
                      "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
                    }
                  },
                  "required": ["message", "accessToken"]
                }
              }
            }
          },
          "400": { "description": "Invalid input" },
          "401": { "description": "Unauthorized" },
          "500": { "description": "Internal server error" }
        },
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "username": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string",
                    "format": "color"
                  }
                },
                "required": ["username", "password"]
              }
            }
          }
        }
      }
    },
    "/auth/signout": {
      "post": {
        "summary": "SignOut",
        "description": "Mobile gửi JSON client=mobile và refreshToken; browser dùng cookie. Thu hồi phiên, trả 204.",
        "requestBody": { "$ref": "#/components/requestBodies/RefreshCredentials" },
        "tags": ["Authentication"],
        "responses": {
          "204": { "description": "Session revoked" },
          "500": { "description": "Internal server error" }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "summary": "RefreshToken",
        "description": "Mobile gửi JSON client=mobile và refreshToken; browser dùng cookie. Trả accessToken mới.",
        "requestBody": { "$ref": "#/components/requestBodies/RefreshCredentials" },
        "tags": ["Authentication"],
        "responses": { "200": { "description": "Access token mới" }, "401": { "description": "Thiếu token" }, "403": { "description": "Phiên không hợp lệ hoặc hết hạn" } }
      }
    },
    "/users/me": {
      "get": {
        "summary": "AuthMe",
        "tags": ["Authentication"],
        "responses": {}
      }
    },
    "/friends/requests": {
      "post": {
        "summary": "Gửi lời mời kết bạn",
        "description": "Người gửi lấy từ access token. Chặn tự gửi, tài khoản không tồn tại, đã là bạn bè và lời mời đang chờ theo cả hai chiều. Gửi trùng đồng thời trả 409.",
        "tags": [
          "Friends"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "to"
                ],
                "properties": {
                  "to": {
                    "type": "string",
                    "pattern": "^[a-fA-F0-9]{24}$",
                    "description": "ID người nhận"
                  },
                  "message": {
                    "type": "string",
                    "maxLength": 300,
                    "description": "Lời nhắn tùy chọn; bỏ khoảng trắng ở hai đầu"
                  }
                }
              },
              "example": {
                "to": "64b000000000000000000002",
                "message": "Chào bạn, kết bạn với mình nhé!"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Đã tạo lời mời",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "message",
                    "request"
                  ],
                  "properties": {
                    "message": {
                      "type": "string"
                    },
                    "request": {
                      "$ref": "#/components/schemas/FriendRequest"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "ID, lời nhắn không hợp lệ hoặc tự gửi cho mình"
          },
          "401": {
            "description": "Chưa đăng nhập"
          },
          "403": {
            "description": "Access token hết hạn hoặc không hợp lệ"
          },
          "404": {
            "description": "Người nhận không tồn tại"
          },
          "409": {
            "description": "Đã là bạn bè hoặc có lời mời đang chờ ở một trong hai chiều"
          },
          "500": {
            "description": "Lỗi hệ thống"
          }
        }
      },
      "get": {
        "summary": "Danh sách lời mời đã gửi và đã nhận",
        "description": "Chỉ lấy lời mời đang chờ của tài khoản đang đăng nhập. Mới nhất trước (createdAt và _id giảm dần). sent populate người nhận (to); received populate người gửi (from). Hồ sơ là null nếu tài khoản đã xóa.",
        "tags": [
          "Friends"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Hai danh sách có thể rỗng",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "sent",
                    "received"
                  ],
                  "properties": {
                    "sent": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "_id",
                          "from",
                          "to",
                          "createdAt",
                          "updatedAt"
                        ],
                        "properties": {
                          "_id": {
                            "type": "string"
                          },
                          "from": {
                            "type": "string"
                          },
                          "to": {
                            "type": "object",
                            "nullable": true,
                            "required": [
                              "_id",
                              "username",
                              "displayName"
                            ],
                            "properties": {
                              "_id": {
                                "type": "string"
                              },
                              "username": {
                                "type": "string"
                              },
                              "displayName": {
                                "type": "string"
                              },
                              "avatarUrl": {
                                "type": "string",
                                "nullable": true
                              }
                            }
                          },
                          "message": {
                            "type": "string",
                            "maxLength": 300
                          },
                          "createdAt": {
                            "type": "string",
                            "format": "date-time"
                          },
                          "updatedAt": {
                            "type": "string",
                            "format": "date-time"
                          }
                        }
                      }
                    },
                    "received": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "_id",
                          "from",
                          "to",
                          "createdAt",
                          "updatedAt"
                        ],
                        "properties": {
                          "_id": {
                            "type": "string"
                          },
                          "from": {
                            "type": "object",
                            "nullable": true,
                            "required": [
                              "_id",
                              "username",
                              "displayName"
                            ],
                            "properties": {
                              "_id": {
                                "type": "string"
                              },
                              "username": {
                                "type": "string"
                              },
                              "displayName": {
                                "type": "string"
                              },
                              "avatarUrl": {
                                "type": "string",
                                "nullable": true
                              }
                            }
                          },
                          "to": {
                            "type": "string"
                          },
                          "message": {
                            "type": "string",
                            "maxLength": 300
                          },
                          "createdAt": {
                            "type": "string",
                            "format": "date-time"
                          },
                          "updatedAt": {
                            "type": "string",
                            "format": "date-time"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Chưa đăng nhập"
          },
          "403": {
            "description": "Access token hết hạn hoặc không hợp lệ"
          },
          "500": {
            "description": "Lỗi hệ thống"
          }
        }
      }
    },
    "/friends/requests/{requestId}/accept": {
      "post": {
        "summary": "Chấp nhận lời mời kết bạn",
        "description": "Chỉ người nhận lời mời được phép xử lý. Không cần body JSON. Tạo quan hệ bạn bè bằng upsert theo cặp ID chuẩn hóa, sau đó xóa lời mời đang chờ.",
        "tags": [
          "Friends"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "requestId",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-fA-F0-9]{24}$"
            }
          }
        ],
        "responses": {
          "400": {
            "description": "ID lời mời không hợp lệ"
          },
          "401": {
            "description": "Chưa đăng nhập"
          },
          "403": {
            "description": "Không phải người nhận hoặc access token hết hạn"
          },
          "404": {
            "description": "Không tìm thấy lời mời, đã được xử lý hoặc người gửi đã xóa tài khoản"
          },
          "500": {
            "description": "Lỗi hệ thống; có thể thử lại"
          },
          "200": {
            "description": "Đã kết bạn và xóa lời mời",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "message",
                    "newFriend"
                  ],
                  "properties": {
                    "message": {
                      "type": "string"
                    },
                    "newFriend": {
                      "$ref": "#/components/schemas/PublicUser"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/friends/requests/{requestId}/decline": {
      "post": {
        "summary": "Từ chối lời mời kết bạn",
        "description": "Chỉ người nhận lời mời được phép xử lý. Không cần body JSON. Chỉ xóa lời mời đang chờ; không tạo quan hệ bạn bè.",
        "tags": [
          "Friends"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "requestId",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-fA-F0-9]{24}$"
            }
          }
        ],
        "responses": {
          "400": {
            "description": "ID lời mời không hợp lệ"
          },
          "401": {
            "description": "Chưa đăng nhập"
          },
          "403": {
            "description": "Không phải người nhận hoặc access token hết hạn"
          },
          "404": {
            "description": "Không tìm thấy lời mời, đã được xử lý hoặc người gửi đã xóa tài khoản"
          },
          "500": {
            "description": "Lỗi hệ thống; có thể thử lại"
          },
          "204": {
            "description": "Đã từ chối, response không có body"
          }
        }
      }
    },
    "/friends/": {
      "get": {
        "summary": "GetAllFriends",
        "tags": ["Friends"],
        "responses": {}
      }
    },
    "/messages/direct": {
      "post": {
        "summary": "SendDirectMessage",
        "tags": ["Messages"],
        "responses": {},
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "recipientId": {
                    "type": "string"
                  },
                  "content": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/conversations/": {
      "post": {
        "summary": "CreateConversation",
        "tags": ["Conversations"],
        "responses": {},
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string"
                  },
                  "name": {
                    "type": "string"
                  },
                  "memberIds": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "get": {
        "summary": "GetConversations",
        "tags": ["Conversations"],
        "responses": {}
      }
    },
    "/conversations/68fb2e6a19c501587577291c/messages": {
      "get": {
        "summary": "GetMessage",
        "tags": ["Conversations"],
        "responses": {}
      }
    },
    "/messages/group": {
      "post": {
        "summary": "SendGroupMessage",
        "tags": ["Messages"],
        "responses": {},
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "conversationId": {
                    "type": "string"
                  },
                  "content": {
                    "type": "string"
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "requestBodies": {
      "RefreshCredentials": {
        "required": false,
        "content": { "application/json": { "schema": {
          "type": "object", "required": ["client", "refreshToken"],
          "properties": { "client": { "type": "string", "enum": ["mobile"] }, "refreshToken": { "type": "string", "maxLength": 512 } }
        } } }
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "DirectoryUser": {
        "allOf": [
          { "$ref": "#/components/schemas/PublicUser" },
          {
            "type": "object",
            "required": ["friendshipStatus"],
            "properties": {
              "friendshipStatus": {
                "type": "string", "enum": ["none", "sent", "received", "friends"],
                "description": "Trạng thái quan hệ với tài khoản đang đăng nhập"
              }
            }
          }
        ]
      },
      "FriendRequest": {
        "type": "object",
        "required": [
          "_id",
          "from",
          "to",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "_id": {
            "type": "string"
          },
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "message": {
            "type": "string",
            "maxLength": 300
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "PublicUser": {
        "type": "object",
        "required": [
          "_id",
          "displayName",
          "username"
        ],
        "properties": {
          "_id": {
            "type": "string"
          },
          "displayName": {
            "type": "string"
          },
          "username": {
            "type": "string"
          },
          "avatarUrl": {
            "type": "string",
            "nullable": true
          }
        }
      },
      "UsersPagination": {
        "type": "object",
        "required": [
          "page",
          "limit",
          "total",
          "totalPages",
          "hasNextPage",
          "hasPreviousPage"
        ],
        "properties": {
          "page": {
            "type": "integer",
            "minimum": 1
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "total": {
            "type": "integer",
            "minimum": 0
          },
          "totalPages": {
            "type": "integer",
            "minimum": 0
          },
          "hasNextPage": {
            "type": "boolean"
          },
          "hasPreviousPage": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ]
}
